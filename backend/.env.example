# REQUIRED: Set DJANGO_SECRET_KEY (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# Set these values through your deployment platform. Do not commit real secrets.
RESREF_ENV=production
# Local development only: do not set any RESREF_STAGING_ADMIN_* variable in
# production. To create a local staging admin manually, set USERNAME, EMAIL,
# PASSWORD, and (for an existing account) ALLOW_PROMOTION=true, then run
# python manage.py ensure_staging_admin. Never configure these in deployment.
# RESREF_STAGING_ADMIN_USERNAME=
# RESREF_STAGING_ADMIN_EMAIL=
# RESREF_STAGING_ADMIN_PASSWORD=
# RESREF_STAGING_ADMIN_RESET_PASSWORD=false
# RESREF_STAGING_ADMIN_ALLOW_PROMOTION=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=resref.com,www.resref.com
DJANGO_CORS_ALLOWED_ORIGINS=https://resref.com,https://www.resref.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://resref.com,https://www.resref.com
FRONTEND_BASE_URL=https://resref.com
# Serve the built React app from Django (the Docker image does this).
SERVE_FRONTEND_FROM_DJANGO=true
# Public host name. On Railway RAILWAY_PUBLIC_DOMAIN is read automatically;
# set this only for a custom domain (e.g. resref.com).
PUBLIC_HOSTNAME=
# Move Django admin away from /admin/ (no leading slash), e.g. manage-7f3k/
DJANGO_ADMIN_PATH=admin/

# PostgreSQL database URL. Production requires this value; local SQLite is
# available only when RESREF_ENV is not production.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
DJANGO_DB_CONN_MAX_AGE=600
DJANGO_DB_SSL_REQUIRE=true

# Enable only after HTTPS is fully configured.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Use None only when the frontend and API are served on different browser sites
# (such as separate Render subdomains). It requires both *_COOKIE_SECURE values.
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
# Retain only salted Django hashes for the five most recent passwords.
PASSWORD_HISTORY_COUNT=5
# Password-reset requests are throttled by both normalized email and client IP.
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_COOLDOWN_SECONDS=3600
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
RESREF_TRUST_PROXY=true
# Number of trusted reverse proxies between the public client and Django.
RESREF_TRUSTED_PROXY_HOPS=1
DJANGO_CSP_ENABLED=true
DJANGO_CSP_REPORT_ONLY=false
# Override only when deployment needs extra trusted asset/payment/analytics domains.
DJANGO_CONTENT_SECURITY_POLICY=
DJANGO_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(self)
DJANGO_LOG_LEVEL=INFO

# Shared Redis cache for rate limits and login lockouts. On Railway, add a Redis
# service and reference its URL here: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=

# Uploaded files (images, PDFs, CVs). Pick ONE mode.
# local: files on disk. In production MEDIA_ROOT must be a persistent volume
#   (Railway Volume mounted at /data, so MEDIA_ROOT=/data/media). The image runs
#   as a non-root user; on Railway also set RAILWAY_RUN_UID=0 so the volume is writable.
# s3: an S3-compatible bucket such as Cloudflare R2 (recommended).
MEDIA_STORAGE=local
MEDIA_ROOT=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public bucket domain, e.g. media.resref.com or pub-xxxx.r2.dev
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media

# Newsletter outbox (sent by `manage.py process_outbox` on a Railway cron).
NEWSLETTER_BATCH_SIZE=200
# Development only: send immediately after queuing instead of waiting for cron.
NEWSLETTER_SEND_INLINE=false

# Research Analyzer sessions (dataset files are private, under MEDIA_ROOT/private/analyzer
# by default; expired ones are removed on upload and at container start).
ANALYZER_STORAGE_DIR=
ANALYZER_SESSION_TTL_SECONDS=7200
ANALYZER_MAX_SESSIONS_PER_USER=5

# Container / gunicorn
RUN_MIGRATIONS_ON_START=true
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# One-time admin bootstrap: set all three, deploy, sign in, then DELETE them.
RESREF_STAGING_ADMIN_USERNAME=
RESREF_STAGING_ADMIN_EMAIL=
RESREF_STAGING_ADMIN_PASSWORD=
RESREF_STAGING_ADMIN_RESET_PASSWORD=false

# Request/data limits. The Research Analyzer separately enforces a 20 MB file limit.
DJANGO_SESSION_COOKIE_AGE=604800
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
USER_TOOL_WORKSPACE_MAX_BYTES=614400

# Google Identity Services OAuth 2.0 Web Client ID.
GOOGLE_OAUTH_CLIENT_ID=

# Stripe test-mode billing foundation. Use only sk_test_ and whsec_ test values here.
# Do not configure live keys until the production billing launch checklist is complete.
STRIPE_SECRET_KEY=sk_test_replace_with_test_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_webhook_secret
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_replace_with_monthly_test_price
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_replace_with_yearly_test_price
# Leave blank to derive from FRONTEND_BASE_URL. If explicitly set, both URLs
# must use the deployed HTTPS frontend origin.
STRIPE_BILLING_SUCCESS_URL=
STRIPE_BILLING_CANCEL_URL=

# Citation metadata providers. Crossref recommends a contact email for its polite pool.
CROSSREF_POLITE_EMAIL=
# Optional: enables OpenAlex as a second title-search provider.
OPENALEX_API_KEY=

# Configure a transactional email provider for password resets.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=ResRef <no-reply@resref.com>
NEWSLETTER_MAX_RECIPIENTS_PER_SEND=1000

# Set to false ONLY while no SMTP provider is configured: new accounts are then
# signed in without the confirmation email. Remove once email works.
ACCOUNT_EMAIL_CONFIRMATION_REQUIRED=true
