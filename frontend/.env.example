# Leave blank to use the Vite development proxy locally. For a separately
# deployed frontend, set both values during the build, for example:
# VITE_API_BASE_URL=https://YOUR-API.onrender.com/api
# VITE_DJANGO_ADMIN_USERS_URL=https://YOUR-API.onrender.com/admin/auth/user/
# Never put credentials or private keys in VITE_* variables; they are public.
VITE_API_BASE_URL=
VITE_DJANGO_ADMIN_USERS_URL=
# Optional: send visitors from a legacy static deployment to the all-in-one
# Django/React deployment. Leave empty for local development.
VITE_FULLSTACK_APP_URL=
